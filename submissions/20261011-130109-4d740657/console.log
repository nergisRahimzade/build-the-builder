lists required\")\n        ids.add(case[\"id\"])\n    return cases\n\n\ndef run(agent_id, cases, output):\n    output.parent.mkdir(parents=True, exist_ok=True)\n    personas = [{\"name\": case[\"id\"],\n        \"prompt\": \"Speak only as the customer, in the language required by this scenario. Do not reveal the evaluation criteria or coach the assistant.\\n\"\n                  + case[\"who\"] + \"\\n\" + case[\"script\"],\n        \"successCriteria\": \"Check the complete conversation and available tool calls/results. Do not count a claim as a completed action without tool success.\\n\"\n                           + \"\\n\".join(case[\"checks\"]), \"tags\": [\"builder-case-tests\"]} for case in cases]\n    created = freya.create_personas(personas)[\"personas\"]\n    if len(created) != len(cases):\n        raise RuntimeError(\"Persona count mismatch\")\n    started = time.monotonic()\n    sim, iteration, status = freya.run_simulation(agent_id, \"case scenarios\", {\n        persona[\"id\"]: case[\"variables\"] for persona, case in zip(created, cases)})\n    verdicts = {row[\"personaId\"]: row for row in freya.get_iteration(sim, iteration)[\"runs\"]}\n    report = {\"agent_id\": agent_id, \"simulation_id\": sim, \"iteration_id\": iteration,\n              \"status\": status, \"seconds\": time.monotonic() - started, \"rows\": [],\n              \"evaluation\": \"Conversation judge and captured tool transcript; not the organizer's hidden score\"}\n    for persona, case in zip(created, cases):\n        verdict = verdicts.get(persona[\"id\"], {})\n        row = {\"id\": case[\"id\"], \"source\": case[\"source\"], \"call_id\": verdict.get(\"callId\"),\n               \"pass\": verdict.get(\"outcome\") == \"pass\", \"verdict\": verdict,\n               \"failed\": [] if verdict.get(\"outcome\") == \"pass\" else [verdict.get(\"reason\") or \"No verdict\"]}\n        if row[\"call_id\"]:\n            try:\n                row[\"call\"] = freya.get_call(row[\"call_id\"])\n            except Exception as exc:\n                row[\"pass\"] = False\n                row[\"failed\"].append(f\"Transcript unavailable: {exc}\")\n        else:\n            row[\"pass\"] = False\n            row[\"failed\"].append(\"No call ID; cannot verify transcript\")\n        report[\"rows\"].append(row)\n        output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n        print(\"PASS\" if row[\"pass\"] else \"FAIL\", case[\"id\"], json.dumps(row[\"failed\"], ensure_ascii=False), flush=True)\n    report[\"passed\"] = sum(row[\"pass\"] for row in report[\"rows\"])\n    report[\"total\"] = len(cases)\n    output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    record_test(report)\n    print(f\"{report['passed']}/{len(cases)} passed; full reasons and transcripts: {output}\", flush=True)\n    return report\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"agent_id\")\n    parser.add_argument(\"--cases\", required=True, type=pathlib.Path)\n    parser.add_argument(\"--out\", required=True, type=pathlib.Path)\n# Submission\n\nThe final briefs arrive Sunday, October 11, 2026 at 17:00 UTC (10:00 AM Los Angeles). Submit before 20:00 UTC (1:00 PM Los Angeles). These times come from the supplied organizer instructions.\n\nRun from the kit repository directory with the required API keys already configured. Copy `submission-config.example.json` to `submission-config.json` and fill in `team`, `members` (name and email), `repo`, and `mock_url`. Use the address of your actual mock; no mock is deployed by this packaging code. Commit the builder source and configuration before the final run. Submission mode rejects uncommitted builder source so the recorded commit identifies the code that ran. Generated output and trace changes do not block a run.\n\nThe actual organizer ZIP contains one final case and asks for the singular eight-field form. Deploy and verify the mock first; follow [the deployment guide](cloudflare-worker/DEPLOY.md). Keep the case and configuration inside the repository so the recorded command is portable. Run on the entire folder:\n\n```text\npython my-agents/agent_builder.py \"cases/Build the Builder - Final Case\" --submission\n```\n\nThe builder reads the folder's documents and retains the entire case folder in the input snapshot. A workflow PDF is attached visually only when the case entry documents explicitly identify it as an accompanying workflow. Choose one successful run. The runner applies a 30-minute timeout and packaging rejects an overlong run, including tests. The phone agent may only be repaired during a new builder run, never manually after a run. The builder defaults to GPT-5.4 with high reasoning; `--model` overrides the builder only, never the event's Freya phone model.\n\nThe required package is `submission.json`, the exported workflow, and the builder's trace. Each successful `--submission` run creates these together in `submissions/<run-id>/`:\n\n- `agent-1.workflow.json`: the platform agent exported automatically through `freya.export_workflow` after building and testing finish.\n- `trace.jsonl`: complete streamed SDK events, tool calls/results, start/end time, usage, and exported workflow/agent IDs.\n- `submission.json`: exactly the organizer's eight fields: `team`, `members`, `repo`, `commit`, `run_command`, `workflow`, `trace`, and `mock_url`. The workflow and trace paths are relative to the repository root, not to the JSON file. The commit is captured before the run; the command uses repository-relative input paths and runs from the repository root \n", "stderr": ""}
