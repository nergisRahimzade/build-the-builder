1: """Freya schema constructors. Policy, paths, values and branch choices come from input sources.
2: 
3: Import these from a builder-generated Python script, then json.dump the graph.
4: These helpers do not infer business rules, attach services automatically, or alter exports.
5: """
6: from copy import deepcopy
7: 
8: 
9: def api_tool(name, url, method, body=None, mapping=None, description="", timeout_ms=30000):
10:     """body is a JSON Schema object from the contract, with runtime/default bindings."""
11:     if not url.startswith(("https://", "http://")) or method not in {"GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"}:
12:         raise ValueError("Provide the actual source URL and HTTP method")
13:     if body is not None and (not isinstance(body, dict) or body.get("type") != "object"):
14:         raise ValueError("body must be an object schema, not a payload string")
15:     properties = {
16:         "url": {"type": "string", "default": url},
17:         "method": {"type": "string", "default": method},
18:         "headers": {"type": "object", "properties": {"Content-Type": {"type": "string", "default": "application/json"}}},
19:     }
20:     if body is not None:
21:         properties["body"] = deepcopy(body)
22:     tool = {"type": "function", "config": {"timeoutMs": timeout_ms}, "function": {
23:         "name": name, "handler": "__function__:api_call", "description": description,
24:         "parameters": {"type": "object", "properties": properties}}}
25:     if mapping:
26:         tool["response_mapping"] = deepcopy(mapping)
27:     return tool
28: 
29: 
30: def end_node(name, message=""):
31:     """A real hang-up, independent of any bank record/close API."""
32:     properties = {"message_mode": {"type": "string", "default": "custom" if message else "none"}}
33:     if message:
34:         properties["spoken_message"] = {"type": "string", "default": message}
35:     return {"name": name, "node_type": "end_call", "on_enter": {"type": "silent"},
36:             "disable_inactivity_monitor": True, "transitions": [], "terminal": {
37:                 "type": "function", "function": {"name": name, "handler": "__function__:end_call",
38:                 "parameters": {"type": "object", "properties": properties}}}}
39: 
40: 
41: def action_node(name, tool, transitions, fallback):
42:     """Run an action on entry; caller supplies response-dependent routes and fallback."""
43:     action = deepcopy(tool)
44:     mapping = action.pop("response_mapping", None)
45:     if not fallback:
46:         raise ValueError("Action nodes need a fallback branch derived from the source")
47:     routes = deepcopy(transitions)
48:     if not routes or routes[-1].get("condition", {}).get("operator") != "always":
49:         routes.append({"target_node": fallback, "description": "Fallback after action result", "condition": {"operator": "always"}})
50:     node = {"name": name, "node_type": "api_request", "on_enter": {"type": "silent"},
51:             "passthrough": True, "passthrough_default_transition": fallback,
52:             "pre_actions": [action], "transitions": routes}
53:     if mapping:
54:         node["response_mapping"] = mapping
55:     return node
