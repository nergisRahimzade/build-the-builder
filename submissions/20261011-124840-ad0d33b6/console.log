100: def retains(expected, actual):
101:     """Allow server-added defaults, but never lost or changed submitted fields."""
102:     if isinstance(expected, dict):
103:         return isinstance(actual, dict) and all(key in actual and retains(value, actual[key]) for key, value in expected.items())
104:     if isinstance(expected, list):
105:         return isinstance(actual, list) and len(expected) == len(actual) and all(retains(a, b) for a, b in zip(expected, actual))
106:     return expected == actual
