113:         errors.append("Platform changed initial_node")
114:     for field in ("tools", "system_prompt", "context_variables"):
115:         if field in expected and not retains(expected[field], actual.get(field)):
116:             errors.append(f"Platform changed workflow.{field}")
117:     for group in ("nodes", "global_nodes"):
118:         for name, node in expected.get(group, {}).items():
119:             saved = actual.get(group, {}).get(name)
120:             if not saved:
121:                 errors.append(f"Platform did not retain node {name}")
122:                 continue
123:             if saved.get("node_type") != node.get("node_type"):
124:                 errors.append(f"Platform changed node type for {name}")
125:             for field in ("terminal", "passthrough", "passthrough_default_transition", "max_node_turns", "max_turn_transition", "response_mapping", "extraction_schema", "on_enter", "task_message", "loop_prompt", "routing_prompt"):
126:                 if field in node and not retains(node[field], saved.get(field)):
127:                     errors.append(f"Platform changed {name}.{field}")
128:             for transition in node.get("transitions", []):
129:                 if not any(t.get("target_node") == transition.get("target_node") and retains(transition.get("condition"), t.get("condition"))
130:                            for t in saved.get("transitions", [])):
131:                     errors.append(f"Platform did not retain a transition from {name}")
