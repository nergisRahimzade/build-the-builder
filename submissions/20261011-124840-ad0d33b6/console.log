12: def api(method, path, body=None, **params):
13:     """Call the API and return the `result` part of its {success, data: {message, result}} envelope."""
14:     q = "?" + urllib.parse.urlencode(params) if params else ""
15:     req = urllib.request.Request(URL + path + q, data=json.dumps(body).encode() if body is not None else None, headers=HEADERS, method=method)
16:     try:
17:         with urllib.request.urlopen(req, timeout=120) as r: out = json.load(r)
18:     except urllib.error.HTTPError as e:
19:         raise RuntimeError(f"{method} {path} -> {e.code}: {e.read().decode()[:1500]}") from None
20:     return out.get("data", {}).get("result", out) if isinstance(out, dict) else out
