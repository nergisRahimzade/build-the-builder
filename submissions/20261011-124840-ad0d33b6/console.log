34: def run(agent_id, cases, output):
35:     output.parent.mkdir(parents=True, exist_ok=True)
36:     personas = [{"name": case["id"],
37:         "prompt": "Speak only as the customer, in the language required by this scenario. Do not reveal the evaluation criteria or coach the assistant.\n"
38:                   + case["who"] + "\n" + case["script"],
39:         "successCriteria": "Check the complete conversation and available tool calls/results. Do not count a claim as a completed action without tool success.\n"
40:                            + "\n".join(case["checks"]), "tags": ["builder-case-tests"]} for case in cases]
41:     created = freya.create_personas(personas)["personas"]
42:     if len(created) != len(cases):
43:         raise RuntimeError("Persona count mismatch")
44:     started = time.monotonic()
45:     sim, iteration, status = freya.run_simulation(agent_id, "case scenarios", {
46:         persona["id"]: case["variables"] for persona, case in zip(created, cases)})
47:     verdicts = {row["personaId"]: row for row in freya.get_iteration(sim, iteration)["runs"]}
48:     report = {"agent_id": agent_id, "simulation_id": sim, "iteration_id": iteration,
49:               "status": status, "seconds": time.monotonic() - started, "rows": [],
50:               "evaluation": "Conversation judge and captured tool transcript; not the organizer's hidden score"}
51:     for persona, case in zip(created, cases):
52:         verdict = verdicts.get(persona["id"], {})
53:         row = {"id": case["id"], "source": case["source"], "call_id": verdict.get("callId"),
54:                "pass": verdict.get("outcome") == "pass", "verdict": verdict,
55:                "failed": [] if verdict.get("outcome") == "pass" else [verdict.get("reason") or "No verdict"]}
56:         if row["call_id"]:
57:             try:
58:                 row["call"] = freya.get_call(row["call_id"])
59:             except Exception as exc:
60:                 row["pass"] = False
61:                 row["failed"].append(f"Transcript unavailable: {exc}")
62:         else:
63:             row["pass"] = False
64:             row["failed"].append("No call ID; cannot verify transcript")
65:         report["rows"].append(row)
66:         output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
67:         print("PASS" if row["pass"] else "FAIL", case["id"], json.dumps(row["failed"], ensure_ascii=False), flush=True)
68:     report["passed"] = sum(row["pass"] for row in report["rows"])
69:     report["total"] = len(cases)
70:     output.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
71:     record_test(report)
72:     print(f"{report['passed']}/{len(cases)} passed; full reasons and transcripts: {output}", flush=True)
73:     return report
