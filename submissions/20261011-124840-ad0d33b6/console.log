112:                 "agentId": agent_id, "name": name, "mode": "chat", "selectedPersonaIds": list(variables_by_persona),
113:                 "customerVariablesMap": variables_by_persona, "maxConcurrentCalls": concurrency, "runsPerPersona": 1, "maxCallDurationSeconds": max_seconds,
114:                 "assistantLlmOverride": AGENT_LLM, "routingLlmOverride": AGENT_LLM, "extractionLlmOverride": AGENT_LLM,
115:                 "personaLlmOverride": SIM_LLM, "analysisLlmOverride": SIM_LLM})
116:             break
117:         except RuntimeError as e:
118:             if "concurrent simulations" not in str(e): raise
119:             print("another simulation is running in this workspace, waiting 30 s", flush=True); time.sleep(30)
120:     sim_id = (sim.get("simulation") or sim)["id"]
121:     while True:
122:         time.sleep(10)
123:         s = api("GET", f"/api/v2/simulations/{sim_id}"); s = s.get("simulation") or s
124:         if s.get("status") in ("completed", "failed", "paused"): break
125:     its = api("GET", f"/api/v2/simulations/{sim_id}/iterations"); its = its.get("iterations") or its.get("items") or its
126:     return sim_id, its[0]["id"], s.get("status")
