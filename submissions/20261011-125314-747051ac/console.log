41: def action_node(name, tool, transitions, fallback):
42:     """Run an action on entry; caller supplies response-dependent routes and fallback."""
43:     action = deepcopy(tool)
44:     mapping = action.pop("response_mapping", None)
45:     if not fallback:
46:         raise ValueError("Action nodes need a fallback branch derived from the source")
47:     routes = deepcopy(transitions)
48:     if not routes or routes[-1].get("condition", {}).get("operator") != "always":
49:         routes.append({"target_node": fallback, "description": "Fallback after action result", "condition": {"operator": "always"}})
