  [Write] {"file_path":"out/brief-a.requirements.json","content":"[\n  {\n    \"requirement\": \"Opening: state name, bank, that the call is recorded; do not say collections, debt, payment or product before identity.\",\n    \"source\": \"briefs/brief-a.md: section 3.1\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"title\", \"last_name\"],\n    \"branch\": \"opening_statement\",\n    \"test_coverage\": \"see test cases for identity and relative handling\"\n  },\n  {\n    \"requirement\": \"Identity: exactly two security questions (DoB and phone_last4), with answer repetition and day_month_swapped retry, max 3 wrong answers total.\",\n    \"source\": \"briefs/brief-a.md: section 5.11-5.15\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"customer_id\"],\n    \"branch\": \"identity_check\",\n    \"test_coverage\": \"see test scripts for correct flows, retries, swaps, decline, max fails\"\n  },\n  {\n    \"requirement\": \"Early/late band: deadlines, business day, proposal logic.\",\n    \"source\": \"briefs/brief-a.md: section 7.18-23\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"now\"],\n    \"branch\": \"deadline_calculation\",\n    \"test_coverage\": \"see promise test cases, boundary checks\"\n  },\n  {\n    \"requirement\": \"Promise creation: amount/amount floor per product type, exact product naming, confirmation before create, retry on service error.\",\n    \"source\": \"briefs/brief-a.md: sections 8, 10.34-38, 10.36-37\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"product_id\", \"amount\", \"date\"],\n    \"branch\": \"promise_capture\",\n    \"test_coverage\": \"see test scenarios on amounts, rejections, floors\"\n  },\n  {\n    \"requirement\": \"Closing: every call ends by close_call with outcome/reason as per outcome table. Always thank and say goodbye before close_call.\",\n    \"source\": \"briefs/brief-a.md: section 12.46-47 and outcome table\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"customer_id\", \"outcome\", \"reason\"],\n    \"branch\": \"closing\",\n    \"test_coverage\": \"all test transcripts must show closing node with correct function\"\n  },\n  {\n    \"requirement\": \"All other customer statements: handle hardship, dispute, paid, request for restructuring, callbacks and relatives as per rules before or after identity.\",\n    \"source\": \"briefs/brief-a.md: rules 4–45\",\n    \"authority\": \"brief-a.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [],\n    \"branch\": \"statement_handling\",\n    \"test_coverage\": \"negative cases, alternative outcomes\"\n  }\n]\n"}
