  [Write] {"file_path":"out/brief-b.requirements.json","content":"[\n  {\n    \"requirement\": \"Support up to three products. Each product has own past_due, days_late, floor, and can have different deadlines.\",\n    \"source\": \"briefs/brief-b.md: 1-3\",\n    \"authority\": \"brief-b.md (overrides A, only where different)\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"products\", \"past_due\", \"days_late\", \"minimum_payment\", \"instalment_amount\"],\n    \"branch\": \"account_multi_product\",\n    \"test_coverage\": \"see multiproduct test cases\"\n  },\n  {\n    \"requirement\": \"State every product before requesting anything; band, deadline per product. Deadlines and attempts tracked per product. Group read-back and confirmation for promises.\",\n    \"source\": \"briefs/brief-b.md: 2, 3, 5, 7\",\n    \"authority\": \"brief-b.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"products\"],\n    \"branch\": \"multi_statement_and_confirmation\",\n    \"test_coverage\": \"see pay-all and partial-refusal cases\"\n  },\n  {\n    \"requirement\": \"Ask first about paying all (if more than one product). If not, process products individually, attempt logic per product.\",\n    \"source\": \"briefs/brief-b.md: 4, 5\",\n    \"authority\": \"brief-b.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [],\n    \"branch\": \"multi_payall_logic\",\n    \"test_coverage\": \"all-multi, partial-multi cases\"\n  },\n  {\n    \"requirement\": \"If promise refused/disputed/paid on only a subset of products, add note per Brief B section 8, reason from defined enum.\",\n    \"source\": \"briefs/brief-b.md: 8, 9, 11\",\n    \"authority\": \"brief-b.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"reason\", \"product_id\"],\n    \"branch\": \"add_note_and_service_error_handling\",\n    \"test_coverage\": \"see no-promise/mixed-multi tests\"\n  },\n  {\n    \"requirement\": \"Transfer after partial completion skips note for any products not actioned yet; no note on transfer, ever.\",\n    \"source\": \"briefs/brief-b.md: 10\",\n    \"authority\": \"brief-b.md\",\n    \"accepted_revision\": \"2026-03-14\",\n    \"runtime_fields_used\": [\"product_id\", \"queue\"],\n    \"branch\": \"transfer_skip_note\",\n    \"test_coverage\": \"transfer-multi cases\"\n  }\n]\n"}
