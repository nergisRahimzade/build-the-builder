  [Write] {"file_path":"out/brief-a.workflow.json","content":"{\n  \"initial_node\": \"initiate_call\",\n  \"system_prompt\": \"You are Freya Bank's digital assistant. Speak English, and follow every step, rule and outcome exactly as specified. Never promise an action unless the tool succeeded in the same turn. Use only information available from policy, calls and tools. For all amounts/dates/deadlines, never assume or calculate beyond what rules, tools, and call variables provide.\",\n  \"test_variables\": {\n    \"customer_id\": \"c_test\",\n    \"first_name\": \"Dana\",\n    \"last_name\": \"Reyes\",\n    \"title\": \"Ms\",\n    \"now\": \"2026-10-14T11:00\"\n  },\n  \"nodes\": {\n    \"initiate_call\": {\n      \"name\": \"initiate_call\",\n      \"node_type\": \"conversation\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Hello, this is Freya Bank's digital assistant. This call is recorded. Am I speaking with {{title}} {{last_name}}?\" },\n      \"on_enter_first_entry_only\": true,\n      \"task_message\": \"Open the call with the required statement. Never say collections, debt, payment, or product before security is completed. Only a clear yes/name/speaking confirms identity for who is on the line. If unclear after two asks, close as not_reached/unclear. If not the customer, handle callback, wrong_number, deceased, relative logic exactly as described. Do not share any info before identity is verified.\",\n      \"extraction_schema\": [],\n      \"tools\": [],\n      \"max_node_turns\": 5,\n      \"max_turn_transition\": \"goodbye_not_reached\",\n      \"transitions\": [\n        {\n          \"target_node\": \"identity_check\",\n          \"description\": \"Confirmed customer is present (yes/name/speaking)\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"The user said yes or gave their correct name/presence confirmation\" }\n        },\n        {\n          \"target_node\": \"callback_collection\",\n          \"description\": \"Non-customer present and callback requested\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"A non-customer answers and wants to schedule a callback\" }\n        },\n        {\n          \"target_node\": \"goodbye_not_reached\",\n          \"description\": \"Second ask or not clear after two asks\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"identity_check\": {\n      \"name\": \"identity_check\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"Do not say why you are calling until identity is verified. Ask the date of birth, then last four digits of the customer’s phone number, one at a time. For each, call verify_identity. If wrong, ask again up to 3 wrongs total (shared between both questions). For day_month_swapped, ask them to say the month as a word and retry that question once (no penalty). Three total wrongs: explain protection and end. If customer does not want to answer, explain once, then close if refusing again. Any missed or failed check closes as not_verified/failed or declined, as per policy.\",\n      \"tools\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 12000, \"maxRetries\": 0 },\n          \"function\": {\n            \"name\": \"verify_identity\",\n            \"handler\": \"__function__:api_call\",\n            \"description\": \"Check one security answer (DoB or last4). Call when customer gives a security answer.\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity\" },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" },\n                    \"field\": { \"type\": \"string\", \"enum\": [\"date_of_birth\", \"phone_last4\"], \"default\": \"{{field}}\", \"description\": \"Which answer: date_of_birth or phone_last4.\" },\n                    \"answer\": { \"type\": \"string\", \"default\": \"{{answer}}\", \"description\": \"DoB as YYYY-MM-DD, phone_last4 as four digits.\" }\n                  },\n                  \"required\": [\"customer_id\", \"field\", \"answer\"]\n                },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"max_node_turns\": 10,\n      \"max_turn_transition\": \"goodbye_not_verified\",\n      \"transitions\": [\n        {\n          \"target_node\": \"debt_lookup\",\n          \"description\": \"Two correct security answers given (all_verified true)\",\n          \"condition\": {\n            \"logic\": \"or\",\n            \"conditions\": [\n              { \"variable\": \"verify_identity_response.data.all_verified\", \"operator\": \"equals\", \"operand\": \"true\" },\n              { \"variable\": \"verify_identity_response.data.all_verified\", \"operator\": \"equals\", \"operand\": \"True\" }\n            ]\n          }\n        },\n        {\n          \"target_node\": \"goodbye_not_verified\",\n          \"description\": \"Three wrong answers\",\n          \"condition\": { \"variable\": \"verify_identity_response.data.wrong_answers_left\", \"operator\": \"equals\", \"operand\": \"0\" }\n        },\n        {\n          \"target_node\": \"goodbye_not_verified\",\n          \"description\": \"Declined to answer\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"Customer declines identity or wants to know reason of call before answering, second time or after explanation.\" }\n        },\n        {\n          \"target_node\": \"identity_check\",\n          \"description\": \"Ask question(s) again, still within allowed tries\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"debt_lookup\": {\n      \"name\": \"debt_lookup\",\n      \"node_type\": \"api_request\",\n      \"on_enter\": { \"type\": \"silent\" },\n      \"passthrough\": true,\n      \"passthrough_default_transition\": \"debt_statement\",\n      \"pre_actions\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 8000, \"maxRetries\": 1 },\n          \"function\": {\n            \"name\": \"get_account\",\n            \"handler\": \"__function__:api_call\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/get_account\" },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }\n                  },\n                  \"required\": [\"customer_id\"]\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"response_mapping\": [\n        { \"path\": \"data.products\", \"variable\": \"products\" },\n        { \"path\": \"data.ok\", \"variable\": \"accounts_ok\" }\n      ],\n      \"transitions\": [\n        {\n          \"target_node\": \"debt_statement\",\n          \"description\": \"Accounts/late product loaded (single product)\",\n          \"condition\": { \"logic\": \"or\", \"conditions\": [ { \"variable\": \"accounts_ok\", \"operator\": \"equals\", \"operand\": \"true\" }, { \"variable\": \"accounts_ok\", \"operator\": \"equals\", \"operand\": \"True\" } ] }\n        },\n        {\n          \"target_node\": \"goodbye_service_error\",\n          \"description\": \"Account lookup failed\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"debt_statement\": {\n      \"name\": \"debt_statement\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"State the product as 'credit card ending XXXX', 'personal loan' or 'car loan', amount past due, and number of days late using values from previous tool call. Do not calculate, use only what is given in products[0]. After, ask if they can pay today. If no or another payment proposal/date/amount, branch as per persuasion and proposal logic from the brief. Use all date deadlines, banding, proposal and confirmation rules strictly. Read back the promise proposal and call create_promise only after confirmation. If service errors in create_promise, retry once, else service_error exit. Always communicate action results to user before proceeding.\",\n      \"tools\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 12000, \"maxRetries\": 0 },\n          \"function\": {\n            \"name\": \"create_promise\",\n            \"handler\": \"__function__:api_call\",\n            \"description\": \"Record a payment promise. One call, after verbal confirmation of the agreement.\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/create_promise\" },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" },\n                    \"product_id\": { \"type\": \"string\", \"default\": \"{{products.0.product_id}}\" },\n                    \"amount\": { \"type\": \"number\", \"default\": \"{{promise_amount}}\", \"description\": \"Promise amount, determined by conversation per rules.\" },\n                    \"date\": { \"type\": \"string\", \"default\": \"{{promise_date}}\", \"description\": \"Promise payment date, as determined.\" }\n                  },\n                  \"required\": [\"customer_id\", \"product_id\", \"amount\", \"date\"]\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"max_node_turns\": 15,\n      \"max_turn_transition\": \"goodbye_no_promise\",\n      \"transitions\": [\n        {\n          \"target_node\": \"promise_confirmed\",\n          \"description\": \"Promise was created successfully.\",\n          \"condition\": {\n            \"logic\": \"or\",\n            \"conditions\": [\n              { \"variable\": \"create_promise_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" },\n              { \"variable\": \"create_promise_response.data.ok\", \"operator\": \"equals\", \"operand\": \"True\" }\n            ]\n          }\n        },\n        {\n          \"target_node\": \"goodbye_service_error\",\n          \"description\": \"Promise creation failed (after retry, if used)\",\n          \"condition\": { \"variable\": \"create_promise_failure_count\", \"operator\": \"greater_than\", \"operand\": 1 }\n        },\n        {\n          \"target_node\": \"goodbye_no_promise\",\n          \"description\": \"Flat refusal or boundary on attempts/date/amount, or refused floor amount or deadline.\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"Customer will not agree to any amount/date or has refused both proposals.\" }\n        },\n        {\n          \"target_node\": \"hardship_offer\",\n          \"description\": \"Customer mentions hardship (illness, death in family, job loss)\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"User mentions illness, death in family, or job loss\" }\n        },\n        {\n          \"target_node\": \"goodbye_paid\",\n          \"description\": \"Customer claims they already paid\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"User says they have already paid\" }\n        },\n        {\n          \"target_node\": \"goodbye_dispute\",\n          \"description\": \"Customer disputes the debt (not theirs, closed, past paid)\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"Customer claims the debt or product is not theirs or settled\" }\n        },\n        {\n          \"target_node\": \"transfer_request\",\n          \"description\": \"Customer requests payment plan, lower instalments or a human\",\n          \"condition\": { \"operator\": \"matches_intent\", \"description\": \"User asks for payment plan, lower instalment or agent/human request\" }\n        },\n        {\n          \"target_node\": \"debt_statement\",\n          \"description\": \"Continue collecting payment proposals until max attempts or branch.\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"promise_confirmed\": {\n      \"name\": \"promise_confirmed\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"Tell the customer: Promise is recorded and a confirmation text message will be sent. Thank and say goodbye before close_call.\",\n      \"tools\": [],\n      \"max_node_turns\": 2,\n      \"max_turn_transition\": \"goodbye_promise\",\n      \"transitions\": [\n        {\n          \"target_node\": \"goodbye_promise\",\n          \"description\": \"Acknowledge successful promise and end\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"callback_collection\": {\n      \"name\": \"callback_collection\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"If the customer cannot talk now, ask for a callback date and time (must be today or next business day, 10:00-19:00, and after 'now'). If not in window, offer only one extra attempt to give a valid time. If still not valid, end as no_callback. If booked, state outcome and close_call as not_reached/callback.\",\n      \"tools\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 8000, \"maxRetries\": 0 },\n          \"function\": {\n            \"name\": \"schedule_callback\",\n            \"handler\": \"__function__:api_call\",\n            \"description\": \"Schedule a callback within allowed window.\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/schedule_callback\" },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" },\n                    \"date\": { \"type\": \"string\", \"default\": \"{{callback_date}}\" },\n                    \"time\": { \"type\": \"string\", \"default\": \"{{callback_time}}\" }\n                  },\n                  \"required\": [\"customer_id\", \"date\", \"time\"]\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"max_node_turns\": 4,\n      \"max_turn_transition\": \"goodbye_callback\",\n      \"transitions\": [\n        {\n          \"target_node\": \"goodbye_callback\",\n          \"description\": \"Callback booked and acknowledged\",\n          \"condition\": {\n            \"logic\": \"or\",\n            \"conditions\": [\n              { \"variable\": \"schedule_callback_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" },\n              { \"variable\": \"schedule_callback_response.data.ok\", \"operator\": \"equals\", \"operand\": \"True\" }\n            ]\n          }\n        },\n        {\n          \"target_node\": \"goodbye_no_callback\",\n          \"description\": \"Failed to book valid callback (wrong window, max attempts)\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"transfer_request\": {\n      \"name\": \"transfer_request\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"If restructuring, transfer to agent with queue 'restructuring'. If agent/human request, confirm if any help can be given, otherwise transfer to agent with queue 'general'. For support request after hardship, transfer to 'support'. Confirm action to user and proceed to close_call.\",\n      \"tools\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 7000, \"maxRetries\": 0 },\n          \"function\": {\n            \"name\": \"transfer_to_agent\",\n            \"handler\": \"__function__:api_call\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/transfer_to_agent\" },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" },\n                    \"queue\": { \"type\": \"string\", \"default\": \"{{transfer_queue}}\", \"enum\": [\"restructuring\", \"general\", \"support\"] }\n                  },\n                  \"required\": [\"customer_id\", \"queue\"]\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"max_node_turns\": 2,\n      \"max_turn_transition\": \"goodbye_transfer\",\n      \"transitions\": [\n        {\n          \"target_node\": \"goodbye_transfer\",\n          \"description\": \"Transfer confirmed\",\n          \"condition\": {\n            \"logic\": \"or\",\n            \"conditions\": [\n              { \"variable\": \"transfer_to_agent_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" },\n              { \"variable\": \"transfer_to_agent_response.data.ok\", \"operator\": \"equals\", \"operand\": \"True\" }\n            ]\n          }\n        },\n        {\n          \"target_node\": \"goodbye_service_error\",\n          \"description\": \"Transfer failed\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"hardship_offer\": {\n      \"name\": \"hardship_offer\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"Say a short sentence of sympathy. Offer to connect with support; if accepted, transfer_to_agent (queue 'support'), else close as no_promise/hardship.\"\n        ,\"tools\": [\n        {\n          \"type\": \"function\",\n          \"config\": { \"timeoutMs\": 7000, \"maxRetries\": 0 },\n          \"function\": {\n            \"name\": \"transfer_to_agent\",\n            \"handler\": \"__function__:api_call\",\n            \"parameters\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/transfer_to_agent\" },\n                \"method\": { \"type\": \"string\", \"default\": \"POST\" },\n                \"headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" }\n                  }\n                },\n                \"body\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" },\n                    \"queue\": { \"type\": \"string\", \"default\": \"support\", \"enum\": [\"support\"] }\n                  },\n                  \"required\": [\"customer_id\", \"queue\"]\n                }\n              }\n            }\n          }\n        }\n      ],\n      \"max_node_turns\": 2,\n      \"max_turn_transition\": \"goodbye_hardship\",\n      \"transitions\": [\n        {\n          \"target_node\": \"goodbye_support_transferred\",\n          \"description\": \"Customer accepts support transfer\",\n          \"condition\": { \"variable\": \"transfer_to_agent_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" }\n        },\n        {\n          \"target_node\": \"goodbye_hardship\",\n          \"description\": \"Customer declines support offer\",\n          \"condition\": { \"operator\": \"always\" }\n        }\n      ]\n    },\n    \"goodbye_not_reached\": {\n      \"name\": \"goodbye_not_reached\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry we couldn’t reach {{title}} {{last_name}} today. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"unclear\" } } } } }\n    },\n    \"goodbye_callback\": {\n      \"name\": \"goodbye_callback\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"We have scheduled your callback. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"callback\" } } } } } },\n    \"goodbye_no_callback\": {\n      \"name\": \"goodbye_no_callback\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry, we can’t schedule a callback. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"no_callback\" } } } } } },\n    \"goodbye_not_verified\": {\n      \"name\": \"goodbye_not_verified\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"We couldn’t verify your identity. For help, please visit a branch or use your mobile app. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_verified\" }, \"reason\": { \"type\": \"string\", \"default\": \"failed\" } } } } } },\n    \"goodbye_no_promise\": {\n      \"name\": \"goodbye_no_promise\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"No payment promise was recorded. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"refused\" } } } } } },\n    \"goodbye_paid\": {\n      \"name\": \"goodbye_paid\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Thank you for your payment. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"paid\" } } } } } },\n    \"goodbye_dispute\": {\n      \"name\": \"goodbye_dispute\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Thank you for letting us know. We will make a note of your dispute. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"dispute\" } } } } } },\n    \"goodbye_service_error\": {\n      \"name\": \"goodbye_service_error\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry, we could not record your promise due to a service error. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"service_error\" } } } } } },\n    \"goodbye_transfer\": {\n      \"name\": \"goodbye_transfer\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"You are being transferred. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"transferred\" }, \"reason\": { \"type\": \"string\", \"default\": \"general\" } } } } } },\n    \"goodbye_support_transferred\": {\n      \"name\": \"goodbye_support_transferred\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"You are being transferred to customer support. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"transferred\" }, \"reason\": { \"type\": \"string\", \"default\": \"support\" } } } } } },\n    \"goodbye_hardship\": {\n      \"name\": \"goodbye_hardship\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Thank you. We wish you the best. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"hardship\" } } } } } },\n    \"goodbye_promise\": {\n      \"name\": \"goodbye_promise\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"You will receive a text message confirming the promise. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"promise\" } } } } } }\n  }\n}\n"}
Wrote D:\NR\Build-the-Builder\build-the-builder-v3\build-the-builder\out\brief-a.workflow.json
  [Write] {"file_path":"out/brief-b.workflow.json","content":"{\n  \"initial_node\": \"initiate_call\",\n  \"system_prompt\": \"You are Freya Bank's digital assistant. Speak English, and follow every step, rule, and outcome as specified. Never promise an action unless the tool succeeded in the same turn. Use only information available from policy, calls, and tools. For all amounts/dates/deadlines, calculate strictly as the rules specify by product.\",\n  \"test_variables\": {\n    \"customer_id\": \"c_test\",\n    \"first_name\": \"Dana\",\n    \"last_name\": \"Reyes\",\n    \"title\": \"Ms\",\n    \"now\": \"2026-10-14T11:00\"\n  },\n  \"nodes\": {\n    \"initiate_call\": {\n      \"name\": \"initiate_call\",\n      \"node_type\": \"conversation\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Hello, this is Freya Bank's digital assistant. This call is recorded. Am I speaking with {{title}} {{last_name}}?\" },\n      \"on_enter_first_entry_only\": true,\n      \"task_message\": \"Open the call as required in the brief. Never mention collections, debt, payment, or products before identity is verified. If a non-customer answers, handle strictly as callback/wrong/deceased/relative. If unclear after second ask, close as not_reached/unclear. Never disclose product or late info before identity verified. All routing per section 3 and 4 of Brief A and B.\",\n      \"extraction_schema\": [],\n      \"tools\": [],\n      \"max_node_turns\": 5,\n      \"max_turn_transition\": \"goodbye_not_reached\",\n      \"transitions\": [\n        { \"target_node\": \"identity_check\", \"description\": \"Confirmed customer is present (yes/name/speaking)\", \"condition\": { \"operator\": \"matches_intent\", \"description\": \"The user confirmed presence (yes/speaking/name).\" } },\n        { \"target_node\": \"callback_collection\", \"description\": \"Non-customer present and callback requested\", \"condition\": { \"operator\": \"matches_intent\", \"description\": \"A non-customer answers and wants to schedule a callback\" } },\n        { \"target_node\": \"goodbye_not_reached\", \"description\": \"Second ask or still unclear\", \"condition\": { \"operator\": \"always\" } }\n      ]\n    },\n    \"identity_check\": {\n      \"name\": \"identity_check\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"Do not mention product or debt before security is passed. Ask date of birth, then phone last4, call verify_identity for each. Strictly: 3 wrongs total, day_month_swapped retry (no penalty), decline logic as per rules. Move on only when both are verified; else close as not_verified/failed or declined. Do not leak product info when non-customer present.\",\n      \"tools\": [\n        { \"type\": \"function\", \"config\": { \"timeoutMs\": 12000, \"maxRetries\": 0 }, \"function\": { \"name\": \"verify_identity\", \"handler\": \"__function__:api_call\", \"description\": \"Call for each security answer, with correct values and fields.\", \"parameters\": { \"type\": \"object\", \"properties\": { \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity\" }, \"body\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"field\": { \"type\": \"string\", \"enum\": [\"date_of_birth\", \"phone_last4\"], \"default\": \"{{field}}\" }, \"answer\": { \"type\": \"string\", \"default\": \"{{answer}}\" } }, \"required\": [\"customer_id\", \"field\", \"answer\"] }, \"method\": { \"type\": \"string\", \"default\": \"POST\" }, \"headers\": { \"type\": \"object\", \"properties\": { \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" } } } } } } }\n      ],\n      \"max_node_turns\": 8,\n      \"max_turn_transition\": \"goodbye_not_verified\",\n      \"transitions\": [\n        { \"target_node\": \"multi_account_lookup\", \"description\": \"Both answers verified\", \"condition\": { \"logic\": \"or\", \"conditions\": [ { \"variable\": \"verify_identity_response.data.all_verified\", \"operator\": \"equals\", \"operand\": \"true\" }, { \"variable\": \"verify_identity_response.data.all_verified\", \"operator\": \"equals\", \"operand\": \"True\" } ] } },\n        { \"target_node\": \"goodbye_not_verified\", \"description\": \"3 wrong answers or declined after explanation\", \"condition\": { \"variable\": \"verify_identity_response.data.wrong_answers_left\", \"operator\": \"equals\", \"operand\": \"0\" } },\n        { \"target_node\": \"identity_check\", \"description\": \"Ask again (still unclear / other answer)\", \"condition\": { \"operator\": \"always\" } }\n      ]\n    },\n    \"multi_account_lookup\": {\n      \"name\": \"multi_account_lookup\",\n      \"node_type\": \"api_request\",\n      \"on_enter\": { \"type\": \"silent\" },\n      \"passthrough\": true,\n      \"passthrough_default_transition\": \"multi_debt_statement\",\n      \"pre_actions\": [\n        { \"type\": \"function\", \"config\": { \"timeoutMs\": 8000, \"maxRetries\": 1 }, \"function\": { \"name\": \"get_account\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/get_account\" }, \"method\": { \"type\": \"string\", \"default\": \"POST\" }, \"headers\": { \"type\": \"object\", \"properties\": { \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" } } }, \"body\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" } }, \"required\": [\"customer_id\"] } } } } } }\n      ],\n      \"response_mapping\": [ { \"path\": \"data.products\", \"variable\": \"products\" }, { \"path\": \"data.ok\", \"variable\": \"accounts_ok\" } ],\n      \"transitions\": [\n        { \"target_node\": \"multi_debt_statement\", \"description\": \"Accounts lookup succeeded.\", \"condition\": { \"logic\": \"or\", \"conditions\": [ { \"variable\": \"accounts_ok\", \"operator\": \"equals\", \"operand\": \"true\" }, { \"variable\": \"accounts_ok\", \"operator\": \"equals\", \"operand\": \"True\" } ] } },\n        { \"target_node\": \"goodbye_service_error\", \"description\": \"Account lookup failed\", \"condition\": { \"operator\": \"always\" } }\n      ]\n    },\n    \"multi_debt_statement\": {\n      \"name\": \"multi_debt_statement\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"State every overdue product from products[]. Use: credit card ending XXXX, personal loan, car loan, as from the API response. State amount and days overdue for each. Band/deadline and payment window are per product. Ask if customer can pay all products today, then follow Brief B decision tree: if not, collect individually, per-product proposal/deadline/amount logic, enforce max persuasion attempt/band rule per product. Confirm all agreed amounts/dates at once, call create_promise per product only after joint confirmation. For products where promise is refused/dispute/paid/service error/hardship, add_note per policy. If transfer/agent is requested in any, transfer as per rules and skip notekeeping for all. Always inform user of result of every action in turn.\",\n      \"tools\": [\n        { \"type\": \"function\", \"config\": { \"timeoutMs\": 12000, \"maxRetries\": 0 }, \"function\": { \"name\": \"create_promise\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/create_promise\" }, \"method\": { \"type\": \"string\", \"default\": \"POST\" }, \"headers\": { \"type\": \"object\", \"properties\": { \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" } } }, \"body\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"product_id\": { \"type\": \"string\", \"default\": \"{{promise_product_id}}\" }, \"amount\": { \"type\": \"number\", \"default\": \"{{promise_amount}}\" }, \"date\": { \"type\": \"string\", \"default\": \"{{promise_date}}\" } }, \"required\": [\"customer_id\", \"product_id\", \"amount\", \"date\"] } } } } },\n        { \"type\": \"function\", \"config\": { \"timeoutMs\": 9000, \"maxRetries\": 0 }, \"function\": { \"name\": \"add_note\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/add_note\" }, \"method\": { \"type\": \"string\", \"default\": \"POST\" }, \"headers\": { \"type\": \"object\", \"properties\": { \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" } } }, \"body\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"product_id\": { \"type\": \"string\", \"default\": \"{{note_product_id}}\" }, \"reason\": { \"type\": \"string\", \"default\": \"{{note_reason}}\", \"enum\": [\"refused\",\"hardship\",\"dispute\",\"paid\",\"service_error\"] } }, \"required\": [\"customer_id\", \"product_id\", \"reason\"] } } } } }\n      ],\n      \"max_node_turns\": 22,\n      \"max_turn_transition\": \"goodbye_service_error\",\n      \"transitions\": [\n        { \"target_node\": \"promise_multi_confirmed\", \"description\": \"Promise(s) created and/or notes for all products as required per rules.\", \"condition\": { \"logic\": \"or\", \"conditions\": [ { \"variable\": \"create_promise_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" }, { \"variable\": \"add_note_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" } ] } },\n        { \"target_node\": \"multi_debt_statement\", \"description\": \"Continue per-product collection logic until done or transferred.\", \"condition\": { \"operator\": \"always\" } }\n      ]\n    },\n    \"promise_multi_confirmed\": {\n      \"name\": \"promise_multi_confirmed\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"Summarize and confirm all product promises and notes. Acknowledge which promises are now recorded and which were refused/paid/disputed/hardship/service error with proper wording. Then end as per rules.\",\n      \"tools\": [],\n      \"max_node_turns\": 3,\n      \"max_turn_transition\": \"goodbye_promise\",\n      \"transitions\": [ { \"target_node\": \"goodbye_promise\", \"description\": \"Wrap up multiproduct result and end\", \"condition\": { \"operator\": \"always\" } } ]\n    },\n    \"callback_collection\": {\n      \"name\": \"callback_collection\",\n      \"node_type\": \"conversation\",\n      \"task_message\": \"If the customer cannot talk now, ask for a callback date and time (must be today or next business day, 10:00-19:00, after 'now'). If not in window, offer one extra chance for valid time, else end as no_callback. If booked, state outcome, close_call as not_reached/callback.\",\n      \"tools\": [\n        { \"type\": \"function\", \"config\": { \"timeoutMs\": 8000, \"maxRetries\": 0 }, \"function\": { \"name\": \"schedule_callback\", \"handler\": \"__function__:api_call\", \"description\": \"Schedule a callback within window.\", \"parameters\": { \"type\": \"object\", \"properties\": { \"url\": { \"type\": \"string\", \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/schedule_callback\" }, \"method\": { \"type\": \"string\", \"default\": \"POST\" }, \"headers\": { \"type\": \"object\", \"properties\": { \"Content-Type\": { \"type\": \"string\", \"default\": \"application/json\" } } }, \"body\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"date\": { \"type\": \"string\", \"default\": \"{{callback_date}}\" }, \"time\": { \"type\": \"string\", \"default\": \"{{callback_time}}\" } }, \"required\": [\"customer_id\", \"date\", \"time\"] } } } } }\n      ],\n      \"max_node_turns\": 3,\n      \"max_turn_transition\": \"goodbye_callback\",\n      \"transitions\": [\n        { \"target_node\": \"goodbye_callback\", \"description\": \"Callback booked and acknowledged\", \"condition\": { \"logic\": \"or\", \"conditions\": [ { \"variable\": \"schedule_callback_response.data.ok\", \"operator\": \"equals\", \"operand\": \"true\" }, { \"variable\": \"schedule_callback_response.data.ok\", \"operator\": \"equals\", \"operand\": \"True\" } ] } },\n        { \"target_node\": \"goodbye_no_callback\", \"description\": \"Failed twice for window\", \"condition\": { \"operator\": \"always\" } }\n      ]\n    },\n    \"goodbye_not_reached\": {\n      \"name\": \"goodbye_not_reached\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry, we couldn’t reach {{title}} {{last_name}} today. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"unclear\" } } } } } }\n    },\n    \"goodbye_callback\": {\n      \"name\": \"goodbye_callback\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"We have scheduled your callback. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"callback\" } } } } } },\n    \"goodbye_no_callback\": {\n      \"name\": \"goodbye_no_callback\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry, we can’t schedule a callback. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_reached\" }, \"reason\": { \"type\": \"string\", \"default\": \"no_callback\" } } } } } },\n    \"goodbye_not_verified\": {\n      \"name\": \"goodbye_not_verified\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"We couldn’t verify your identity. For help, please visit a branch or use your mobile app. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"not_verified\" }, \"reason\": { \"type\": \"string\", \"default\": \"failed\" } } } } } },\n    \"goodbye_no_promise\": {\n      \"name\": \"goodbye_no_promise\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"No payment promise was recorded for any product. Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"refused\" } } } } } },\n    \"goodbye_paid\": {\n      \"name\": \"goodbye_paid\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Thank you for your payment. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"paid\" } } } } } },\n    \"goodbye_service_error\": {\n      \"name\": \"goodbye_service_error\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"Sorry, we could not record all your promises due to a service error. Goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"no_promise\" }, \"reason\": { \"type\": \"string\", \"default\": \"service_error\" } } } } } },\n    \"goodbye_promise\": {\n      \"name\": \"goodbye_promise\",\n      \"node_type\": \"end_call\",\n      \"on_enter\": { \"type\": \"tts\", \"text\": \"You will receive a text message confirming your promise(s). Thank you and goodbye.\" },\n      \"disable_inactivity_monitor\": true,\n      \"transitions\": [],\n      \"terminal\": { \"type\": \"function\", \"function\": { \"name\": \"close_call\", \"handler\": \"__function__:api_call\", \"parameters\": { \"type\": \"object\", \"properties\": { \"customer_id\": { \"type\": \"string\", \"default\": \"{{customer_id}}\" }, \"outcome\": { \"type\": \"string\", \"default\": \"promise\" } } } } } }\n  }\n}\n"}
