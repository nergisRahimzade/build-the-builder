{
  "initial_node": "opening",
  "system_prompt": "You are the digital assistant of Freya Bank. Speak English. All your actions must strictly follow the bank's brief and use only the information and tools available.",
  "test_variables": {
    "customer_id": "c_test",
    "first_name": "Dana",
    "last_name": "Reyes",
    "title": "Mr",
    "now": "2026-10-14T11:00"
  },
  "global_nodes": {},
  "nodes": {
    "opening": {
      "name": "opening",
      "node_type": "conversation",
      "on_enter": {
        "type": "tts",
        "text": "Hello, this is the digital assistant calling from Freya Bank, and this call is recorded. Am I speaking with {{title}} {{last_name}}?"
      },
      "task_message": "Greet the person. State you are a digital assistant from Freya Bank and the call is recorded. Do not mention collections, debt, payment or the product before confirming identity. Ask: \"Am I speaking with {{title}} {{last_name}}?\". Only proceed if the answer is 'yes', 'that's me', 'speaking' or the correct name. If not, ask again. If unclear after two asks, close as not_reached/unclear. If you get a question, answer it first, then re-ask. If the person on the line is not the customer, follow rules for 'someone else answers'. If asked if you are a robot or AI, say you're Freya Bank's digital assistant and continue.",
      "extraction_schema": [
        {"name": "identity_status", "type": "string", "enum_values": ["confirmed", "not_confirmed", "not_reached", "unclear", "callback", "no_callback", "wrong_number", "deceased"], "description": "Identity confirmation status based on the user's responses.", "min_confidence": 0.8}
      ],
      "transitions": [
        {"target_node": "identity_verification", "description": "Identity confirmed: it's the right customer.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "confirmed"} ]}},
        {"target_node": "callback", "description": "Callback is requested.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "callback"} ]}},
        {"target_node": "not_reached_no_callback", "description": "No suitable callback time offered.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "no_callback"} ]}},
        {"target_node": "not_reached_wrong_number", "description": "Wrong number.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "wrong_number"} ]}},
        {"target_node": "not_reached_deceased", "description": "Deceased.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "deceased"} ]}},
        {"target_node": "not_reached_unclear", "description": "Unclear after two asks.", "condition": {"logic": "or", "conditions": [ {"variable": "identity_status", "operator": "equals", "operand": "unclear"} ]}}
      ]
    },
    "callback": {
      "name": "callback",
      "node_type": "conversation",
      "task_message": "Obtain a date and time for callback from today or the next business day (10:00-19:00, after now). If a valid time is given, call schedule_callback with the date and time, inform the person, then close_call with not_reached/callback.  If not, ask once for another time, and if again invalid, close_call with not_reached/no_callback.",
      "tools": [
        {
          "type": "function",
          "function": {
            "description": "Schedule a callback for the customer.",
            "name": "schedule_callback",
            "handler": "__function__:api_call",
            "parameters": {
              "type": "object",
              "properties": {
                "customer_id": {"type": "string", "default": "{{customer_id}}"},
                "date": {"type": "string", "default": "{{callback_date}}"},
                "time": {"type": "string", "default": "{{callback_time}}"}
              },
              "required": ["customer_id", "date", "time"]
            }
          }
        }
      ],
      "extraction_schema": [
        {"name": "callback_date", "type": "date", "description": "Callback date.", "min_confidence": 0.8},
        {"name": "callback_time", "type": "string", "description": "Callback time (HH:MM).", "min_confidence": 0.8}
      ],
      "transitions": [
        {"target_node": "end_not_reached_callback", "description": "Callback scheduled.", "condition": {"logic": "or", "conditions": [ {"variable": "callback_date", "operator": "is_set"}, {"variable": "callback_time", "operator": "is_set"} ]}}
      ]
    },
    "not_reached_no_callback": {
      "name": "not_reached_no_callback",
      "node_type": "end_call",
      "on_enter": {"type": "silent"},
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "not_reached_no_callback",
          "handler": "__function__:end_call",
          "parameters": {"type": "object", "properties": {"message_mode": {"type": "string", "default": "custom"}, "spoken_message": {"type": "string", "default": "Sorry, I can't schedule a callback at that time. Thank you and goodbye."}}}
        }
      }
    },
    "not_reached_wrong_number": {
      "name": "not_reached_wrong_number",
      "node_type": "end_call",
      "on_enter": {"type": "silent"},
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "not_reached_wrong_number",
          "handler": "__function__:end_call",
          "parameters": {"type": "object", "properties": {"message_mode": {"type": "string", "default": "custom"}, "spoken_message": {"type": "string", "default": "Thank you for letting us know. Goodbye."}}}
        }
      }
    },
    "not_reached_deceased": {
      "name": "not_reached_deceased",
      "node_type": "end_call",
      "on_enter": {"type": "silent"},
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "not_reached_deceased",
          "handler": "__function__:end_call",
          "parameters": {"type": "object", "properties": {"message_mode": {"type": "string", "default": "custom"}, "spoken_message": {"type": "string", "default": "I am sorry for your loss. Goodbye."}}}
        }
      }
    },
    "not_reached_unclear": {
      "name": "not_reached_unclear",
      "node_type": "end_call",
      "on_enter": {"type": "silent"},
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "not_reached_unclear",
          "handler": "__function__:end_call",
          "parameters": {"type": "object", "properties": {"message_mode": {"type": "string", "default": "custom"}, "spoken_message": {"type": "string", "default": "Sorry, I could not confirm the customer. Goodbye."}}}
        }
      }
    },
    "end_not_reached_callback": {
      "name": "end_not_reached_callback",
      "node_type": "end_call",
      "on_enter": {"type": "silent"},
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "not_reached_callback",
          "handler": "__function__:end_call",
          "parameters": {"type": "object", "properties": {"message_mode": {"type": "string", "default": "custom"}, "spoken_message": {"type": "string", "default": "Thank you, I have scheduled the callback. Goodbye."}}}
        }
      }
    }
  }
}
